---
/**
 * Un niveau de l'arborescence du dépôt ; les dossiers se replient (<details>),
 * les noms fautifs sont signalés par une icône et le problème en toutes lettres.
 */
interface Props {
  noeuds: any[];
}

const { noeuds } = Astro.props;
const PROBLEME: Record<string, string> = {
  majuscule: "majuscule",
  espace: "espace",
  accent: "accent",
  caractere: "caractère spécial",
};
---

<ul class="space-y-0.5 pl-4 first:pl-0">
  {
    noeuds.map((n) =>
      n.dossier ? (
        <li>
          <details open>
            <summary class="min-h-7 cursor-pointer font-mono text-sm leading-7">
              {n.nom}/
              {n.fautifs > 0 && (
                <span class="ml-2 font-sans text-xs font-semibold text-non-respecte">
                  ✕ {n.fautifs} nom{n.fautifs > 1 ? "s" : ""} fautif{n.fautifs > 1 ? "s" : ""}
                </span>
              )}
            </summary>
            <Astro.self noeuds={n.enfants} />
          </details>
        </li>
      ) : (
        <li class="font-mono text-sm">
          {n.problemes.length > 0 ? (
            <span class="rounded bg-non-respecte-fond px-1 text-non-respecte">
              <span aria-hidden="true">✕ </span>
              {n.nom}
              <span class="ml-2 font-sans text-xs font-semibold">
                {n.problemes.map((p: string) => PROBLEME[p]).join(", ")}
              </span>
            </span>
          ) : (
            <span>{n.nom}</span>
          )}
        </li>
      )
    )
  }
</ul>
