---
/**
 * Vue par page : une matrice pages × contrôles.
 * Chaque cellule montre un symbole et sa valeur ; le détail apparaît au survol ou au focus,
 * et un clic mène au critère concerné. En-têtes de ligne et de colonne fixes au défilement.
 */
import { COLONNES_PAGE } from "../config/controlesPage.js";

interface Props {
  pages: any[] | undefined;
}

const { pages } = Astro.props;

const SYMBOLE: Record<string, { icone: string; mot: string; classe: string }> = {
  respecte: { icone: "✓", mot: "respecté", classe: "text-respecte" },
  "non-respecte": { icone: "✕", mot: "non respecté", classe: "text-non-respecte bg-non-respecte-fond" },
  partiel: { icone: "◐", mot: "partiel", classe: "text-partiel bg-partiel-fond" },
  "non-mesurable": { icone: "?", mot: "non mesurable", classe: "text-neutre" },
};

const echecsParColonne = Object.fromEntries(
  COLONNES_PAGE.map(({ cle }) => [cle, (pages ?? []).filter((p) => p.controles[cle].verdict === "non-respecte").length])
);
---

<section id="par-page" aria-labelledby="titre-par-page" class="rounded-lg border border-bordure bg-surface">
  <header class="border-b border-bordure px-4 py-3">
    <h2 id="titre-par-page" class="text-xl font-bold">Vue par page</h2>
    <p class="text-sm text-texte-doux">Les critères vérifiés page par page. Survolez ou parcourez une cellule pour son détail ; un clic ouvre le critère.</p>
  </header>

  {
    !pages ? (
      <p class="px-4 py-3 text-sm text-texte-doux">Non mesurable : l'inventaire des pages n'a pas abouti.</p>
    ) : (
      <div class="matrice max-h-[70vh] overflow-auto" tabindex="0" role="region" aria-label="Matrice des pages et des contrôles, défilable">
        <table class="w-full border-separate border-spacing-0 text-sm">
          <caption class="sr-only">
            Vue par page : {pages.length} pages, {COLONNES_PAGE.length} contrôles
          </caption>
          <thead>
            <tr>
              <th scope="col" class="sticky top-0 left-0 z-20 border-b border-bordure bg-surface px-4 py-2 text-left font-semibold">
                Page
              </th>
              {COLONNES_PAGE.map((col) => (
                <th scope="col" class="sticky top-0 z-10 border-b border-bordure bg-surface px-2 py-2 text-center align-bottom font-semibold">
                  <a href={`#critere-${col.critere}`} class="block text-xs leading-tight hover:text-accent">
                    {col.libelle}
                    <span class="block font-mono font-normal text-texte-doux">{col.critere}</span>
                  </a>
                  {echecsParColonne[col.cle] > 0 && (
                    <span class="mt-0.5 block text-xs font-semibold text-non-respecte">
                      {echecsParColonne[col.cle]} ✕<span class="sr-only"> pages en échec</span>
                    </span>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {pages.map((page) => (
              <tr>
                <th scope="row" class="sticky left-0 z-10 border-b border-bordure bg-surface px-4 py-2 text-left font-normal whitespace-nowrap">
                  <span class="block font-mono text-sm">{page.fichier}</span>
                  {page.titre && <span class="block max-w-56 truncate text-xs text-texte-doux">{page.titre}</span>}
                </th>
                {COLONNES_PAGE.map((col) => {
                  const cellule = page.controles[col.cle];
                  const s = SYMBOLE[cellule.verdict];
                  return (
                    <td class="border-b border-bordure p-1 text-center">
                      <a href={`#critere-${col.critere}`} class={`cellule relative inline-flex min-h-9 min-w-11 items-center justify-center gap-1 rounded px-1.5 ${s.classe}`}>
                        <span aria-hidden="true" class="font-semibold">{s.icone}</span>
                        {cellule.valeur && <span aria-hidden="true" class="text-xs">{cellule.valeur}</span>}
                        <span class="sr-only">
                          {col.libelle}, {page.fichier} : {s.mot}
                          {cellule.detail ? ` (${cellule.detail})` : ""}
                        </span>
                        {cellule.detail && (
                          <span class="bulle" aria-hidden="true">
                            <span class="font-semibold">{s.mot}</span> · {cellule.detail}
                          </span>
                        )}
                      </a>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</section>

<style>
  /* Détail d'une cellule : au survol ou au focus clavier */
  .bulle {
    display: none;
    position: absolute;
    z-index: 30;
    bottom: calc(100% + 0.25rem);
    left: 50%;
    translate: -50% 0;
    width: max-content;
    max-width: 16rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    background: var(--color-texte);
    color: white;
    font-size: 0.75rem;
    text-align: left;
    white-space: normal;
  }
  .cellule:hover .bulle,
  .cellule:focus-visible .bulle {
    display: block;
  }
  /* Les premières lignes affichent leur détail vers le bas, pour rester visibles */
  tbody tr:nth-child(-n + 2) .bulle {
    bottom: auto;
    top: calc(100% + 0.25rem);
  }
</style>
