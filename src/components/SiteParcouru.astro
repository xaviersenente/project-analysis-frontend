---
/**
 * Portfolio : le site en ligne parcouru. Une ligne par page, avec ce que mesurent Q3 à Q11 ;
 * puis les services tiers et les cookies déposés sans aucune action du visiteur.
 * Information pour le jury : la note reste la sienne.
 */
import { date, nombre } from "../lib/format.js";

interface Props {
  parcours: any | undefined;
}

const { parcours } = Astro.props;
const NOTE_ECO: Record<string, string> = { A: "text-respecte", B: "text-respecte", C: "text-respecte", D: "text-partiel", E: "text-non-respecte", F: "text-non-respecte", G: "text-non-respecte" };
---

<section id="site" aria-labelledby="titre-site" class="rounded-lg border border-bordure bg-surface">
  <header class="border-b border-bordure px-4 py-3">
    <h2 id="titre-site" class="text-xl font-bold">Site parcouru</h2>
    {
      parcours && (
        <p class="text-sm text-texte-doux">
          <a href={parcours.url} class="font-mono text-accent underline underline-offset-2">{parcours.url}</a>, parcouru le {date(parcours.parcouruLe)} :{" "}
          {nombre(parcours.pages.length)} page{parcours.pages.length > 1 ? "s" : ""}
          {parcours.nonParcourues > 0 && <>, {nombre(parcours.nonParcourues)} autres non parcourues (limite atteinte)</>}.
          {" "}Sitemap : {parcours.sitemap.present ? `${nombre(parcours.sitemap.urls)} adresses` : "absent"} ; robots.txt : {parcours.robots ? "présent" : "absent"} ;
          HTTPS : {parcours.https.actif ? (parcours.https.redirection === false ? "oui, sans redirection depuis http://" : "oui") : "non"}.
        </p>
      )
    }
  </header>
  {
    !parcours ? (
      <p class="px-4 py-3 text-sm text-texte-doux">Non mesurable : le site en ligne n'a pas été parcouru.</p>
    ) : (
      <div class="space-y-4 py-3">
        <div class="overflow-x-auto px-4" tabindex="0" role="region" aria-label="Pages parcourues, défilable">
          <table class="w-full text-left text-sm">
            <caption class="sr-only">Pages parcourues et leurs mesures</caption>
            <thead class="border-b border-bordure text-texte-doux">
              <tr>
                <th scope="col" class="px-2 py-2 font-semibold">Page</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">Code</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">EcoIndex</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">Poids</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">Requêtes</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">Éléments</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">Accessibilité</th>
                <th scope="col" class="px-2 py-2 text-center font-semibold">360 px</th>
                <th scope="col" class="px-2 py-2 text-right font-semibold">Tiers</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-bordure">
              {parcours.pages.map((p: any) =>
                p.ecoindex ? (
                  <tr>
                    <th scope="row" class="px-2 py-1.5 font-normal">
                      <a href={p.url} class="font-mono text-xs underline underline-offset-2">{p.chemin}</a>
                      {p.titre && <span class="block max-w-xs truncate text-xs text-texte-doux">{p.titre}</span>}
                    </th>
                    <td class="px-2 py-1.5 text-right font-mono text-xs">{p.statut}</td>
                    <td class="px-2 py-1.5 text-right">
                      <span class:list={["font-semibold", NOTE_ECO[p.ecoindex.note]]}>{p.ecoindex.note}</span> <span class="text-xs text-texte-doux">{nombre(p.ecoindex.score)}</span>
                    </td>
                    <td class="px-2 py-1.5 text-right">{nombre(p.poidsKo)} Ko</td>
                    <td class="px-2 py-1.5 text-right">{nombre(p.requetes)}</td>
                    <td class="px-2 py-1.5 text-right">{nombre(p.dom)}</td>
                    <td class:list={["px-2 py-1.5 text-right", p.violations > 0 && "font-semibold text-non-respecte"]}>{p.violations > 0 ? `${nombre(p.violations)} erreur${p.violations > 1 ? "s" : ""}` : "—"}</td>
                    <td class="px-2 py-1.5 text-center">{p.debordement ? <span class="text-non-respecte">✕<span class="sr-only"> défile horizontalement</span></span> : <span class="text-respecte">✓<span class="sr-only"> tient dans l'écran</span></span>}</td>
                    <td class:list={["px-2 py-1.5 text-right", p.tiers > 0 && "text-partiel"]}>{p.tiers > 0 ? nombre(p.tiers) : "—"}</td>
                  </tr>
                ) : (
                  <tr>
                    <th scope="row" class="px-2 py-1.5 font-normal"><a href={p.url} class="font-mono text-xs underline underline-offset-2">{p.chemin}</a></th>
                    <td class="px-2 py-1.5 text-right font-mono text-xs text-non-respecte">{p.statut || "—"}</td>
                    <td colspan="7" class="px-2 py-1.5 text-texte-doux">{p.erreur ?? (p.statut >= 400 ? "adresse en erreur" : "pas une page HTML du site")}</td>
                  </tr>
                )
              )}
            </tbody>
          </table>
        </div>

        <div class="grid gap-4 px-4 lg:grid-cols-2">
          <div>
            <h3 class="mb-1 text-sm font-semibold">Services tiers chargés sans action du visiteur</h3>
            {parcours.tiers.length === 0 ? (
              <p class="text-sm text-respecte">✓ Aucun.</p>
            ) : (
              <ul class="space-y-1 text-sm">
                {parcours.tiers.map((t: any) => (
                  <li>
                    <span class="font-semibold">{t.categorie}</span> <span class="font-mono text-xs">{t.hote}</span>
                    <span class="text-texte-doux"> · {nombre(t.pages.length)} page{t.pages.length > 1 ? "s" : ""}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div>
            <h3 class="mb-1 text-sm font-semibold">Cookies déposés sans action du visiteur</h3>
            {parcours.cookies.length === 0 ? (
              <p class="text-sm text-respecte">✓ Aucun.</p>
            ) : (
              <ul class="space-y-1 text-sm">
                {parcours.cookies.map((c: any) => (
                  <li>
                    <span class="font-mono text-xs">{c.nom}</span> <span class="text-texte-doux">· {c.domaine}{c.tiers && " (tiers)"}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    )
  }
</section>
