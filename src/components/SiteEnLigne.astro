---
/**
 * Contrôle léger du site en ligne (lot 4) : pages et ressources en erreur, et pourquoi
 * quand le dépôt l'explique. Rien de noté : l'analyse porte sur le dépôt.
 */
import { date, nombre } from "../lib/format.js";

interface Props {
  enLigne: any;
  sha: string;
}

const { enLigne, sha } = Astro.props;
const CAUSES: Record<string, string> = {
  casse: "erreur de casse dans le dépôt",
  "chemin-racine": "chemin en « / » : vise la racine du domaine",
  "absent-du-depot": "fichier absent du dépôt",
};
---

<div class="px-4">
  <h3 class="mb-1 font-semibold">
    Site en ligne
    <span class="ml-2 text-sm font-normal">
      {
        !enLigne.repond ? (
          <span class="font-semibold text-non-respecte">✕ {enLigne.raison}</span>
        ) : enLigne.erreurs.length > 0 ? (
          <span class="font-semibold text-non-respecte">✕ {enLigne.erreurs.length} adresse{enLigne.erreurs.length > 1 ? "s" : ""} en erreur</span>
        ) : (
          <span class="text-respecte">✓ toutes les adresses répondent</span>
        )
      }
    </span>
  </h3>
  <p class="text-sm text-texte-doux">
    <a href={enLigne.url} class="font-mono text-accent underline underline-offset-2">{enLigne.url}</a>, vérifié le {date(enLigne.verifieLe)}.
    {enLigne.repond && <> {nombre(enLigne.pages.total)} pages et {nombre(enLigne.ressources.total)} ressources demandées.</>}
    {enLigne.ressources.nonVerifiees > 0 && <> {nombre(enLigne.ressources.nonVerifiees)} ressources non vérifiées (limite atteinte).</>}
    {" "}Information seulement : rien n'est noté.
  </p>
  {
    enLigne.deploiement && (
      <p class:list={["mt-1 text-sm", enLigne.deploiement.versionEvaluee ? "text-respecte" : "font-semibold text-partiel"]}>
        {enLigne.deploiement.versionEvaluee ? "✓ " : "◐ "}
        GitHub Pages a déployé <span class="font-mono">{enLigne.deploiement.sha.slice(0, 7)}</span> le {date(enLigne.deploiement.date)}
        {enLigne.deploiement.versionEvaluee ? " : c'est la version évaluée." : <> ; la version évaluée est <span class="font-mono">{sha.slice(0, 7)}</span>.</>}
      </p>
    )
  }
  {
    enLigne.erreurs.length > 0 && (
      <div class="mt-2 overflow-x-auto" tabindex="0" role="region" aria-label="Adresses en erreur, défilable">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Adresses du site en ligne en erreur</caption>
          <thead class="border-b border-bordure text-texte-doux">
            <tr>
              <th scope="col" class="px-2 py-2 font-semibold">Chemin</th>
              <th scope="col" class="px-2 py-2 text-right font-semibold">Code</th>
              <th scope="col" class="px-2 py-2 font-semibold">Cause</th>
              <th scope="col" class="px-2 py-2 font-semibold">Cité par</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-bordure">
            {enLigne.erreurs.map((e: any) => (
              <tr>
                <td class="px-2 py-1.5 font-mono text-xs"><a href={e.url} class="underline underline-offset-2">{e.chemin}</a>{e.type === "page" && <span class="ml-1 font-sans text-texte-doux">(page)</span>}</td>
                <td class="px-2 py-1.5 text-right font-mono text-xs">{e.statut || "—"}</td>
                <td class="px-2 py-1.5">{e.cause ? CAUSES[e.cause] : <span class="text-texte-doux">présent dans la version évaluée : site pas à jour ?</span>}</td>
                <td class="px-2 py-1.5 font-mono text-xs">{e.citePar.map((c: any) => `${c.page}${c.ligne ? `:${c.ligne}` : ""}`).join(", ") || "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</div>
