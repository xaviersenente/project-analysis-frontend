---
/**
 * Une ligne de critère, dépliable au clic ou au clavier (<details> natif).
 * Recommandations calmes, jamais en rouge ; bonus valorisé quand il est obtenu, neutre sinon.
 */
import Verdict from "./Verdict.astro";
import IconeMethode from "./IconeMethode.astro";
import Occurrences from "./Occurrences.astro";
import ListeAlt from "./ListeAlt.astro";
import NoteEnseignant from "./NoteEnseignant.vue";
import { valeurCritere, seuilCritere, nombre, points } from "../lib/format.js";
import { libelleOrigine } from "../lib/criteres.js";

interface Props {
  critere: any;
  // Images du site, pour juger la qualité des alt (A6)
  images?: any[];
  // Projet : pour enregistrer les notes en mode local
  slug?: string;
}

const { critere: c, images, slug } = Astro.props;
// Mode local : formulaires de notation en développement seulement ; le site construit est en lecture seule
const modeLocal = import.meta.env.DEV && Boolean(slug);
const ens = c.enseignant;
const verdictCorrige = ens && ens.verdictOutil !== "a-juger" && ens.verdictOutil !== c.verdict;
const LIBELLE_VERDICT: Record<string, string> = {
  respecte: "respecté",
  partiel: "partiel",
  "non-respecte": "non respecté",
  "non-mesurable": "non mesurable",
  "a-juger": "à juger",
};

const STATUT: Record<string, { libelle: string; classe: string }> = {
  C: { libelle: "Contrainte", classe: "text-texte" },
  R: { libelle: "Recommandation", classe: "text-texte-doux" },
  I: { libelle: "Information", classe: "text-texte-doux" },
  B: { libelle: "Bonus", classe: "text-bonus font-semibold" },
};

const METHODE: Record<string, string> = {
  auto: "analyse du code",
  depot: "lecture du dépôt",
  navigateur: "navigateur automatisé",
  ia: "proposition de l'IA, à valider",
  manuel: "jugement manuel",
};

const valeurTexte =
  c.verdict === "non-mesurable"
    ? null
    : c.valeur === null && !c.detailValeur
      ? null
      : valeurCritere(c);
const bonusObtenu = c.statut === "B" && c.points?.obtenus > 0;
const origine = libelleOrigine(c.origine);
const texteRecherche = `${c.id} ${c.libelle}${origine ? ` ${origine}` : ""}`;
---

<li
  id={`critere-${c.id}`}
  data-critere
  data-verdict={c.verdict}
  data-statut={c.statut}
  data-origine={c.origine}
  data-texte={texteRecherche}
  class:list={["scroll-mt-20", c.statut === "R" && "bg-page/40"]}>
  <details class="ligne-critere group">
    <summary
      class="grid min-h-11 cursor-pointer list-none grid-cols-[1rem_3rem_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 px-4 py-2 hover:bg-neutre-fond xl:grid-cols-[1rem_3rem_minmax(0,1fr)_7.5rem_8.5rem_12rem_4.5rem_1.25rem]">
      <svg viewBox="0 0 16 16" class="size-3 text-texte-doux transition-transform group-open:rotate-90" aria-hidden="true"
        ><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
      >
      <span class="font-mono text-sm font-semibold">{c.id}</span>
      <span class="min-w-0">
        {c.libelle}
        {origine && (
          <span class="ml-1.5 inline-block rounded border border-bordure bg-page px-1.5 align-middle text-xs font-semibold whitespace-nowrap text-texte-doux" title="Exigence d'une SAÉ précédente, reprise pour information : elle ne compte pas dans la note">
            {origine}
          </span>
        )}
      </span>
      <span class={`hidden text-xs xl:block ${STATUT[c.statut].classe}`}>{STATUT[c.statut].libelle}</span>
      <span class="inline-flex items-center gap-1">
        <Verdict verdict={c.verdict} statut={c.statut} />
        {verdictCorrige && <span class="text-xs text-accent" title={`Corrigé par l'enseignant ; l'outil indiquait « ${LIBELLE_VERDICT[ens.verdictOutil]} »`}>✎<span class="sr-only"> corrigé par l'enseignant</span></span>}
      </span>
      <span class="col-span-2 col-start-3 text-sm xl:col-span-1 xl:col-start-auto">
        {
          c.verdict === "non-mesurable" ? (
            <span class="text-texte-doux">Non mesurable</span>
          ) : valeurTexte ? (
            <>
              {valeurTexte} <span class="text-texte-doux">· {seuilCritere(c)}</span>
            </>
          ) : (
            <span class="text-texte-doux">{seuilCritere(c)}</span>
          )
        }
      </span>
      <span class="hidden text-right text-sm xl:block">
        {
          c.statut === "C" && c.points ? (
            c.points.obtenus === null ? (
              <span class="text-texte-doux">— / {nombre(c.points.max)}</span>
            ) : (
              <>
                <span class="font-semibold">{nombre(c.points.obtenus)}</span>
                <span class="text-texte-doux"> / {nombre(c.points.max)}</span>
              </>
            )
          ) : bonusObtenu ? (
            <span class="font-semibold text-bonus">+ {nombre(c.points.obtenus)}</span>
          ) : null
        }
      </span>
      <span class="hidden xl:inline-flex"><IconeMethode methode={c.methode} /></span>
    </summary>

    <div class="space-y-3 border-t border-bordure bg-page px-4 py-3 md:pl-[5.5rem]">
      <p class="text-sm">
        <span class="font-semibold">{c.methode === "manuel" ? "Ce qu'il faut juger" : "Piste"} :</span>
        {c.piste}
      </p>
      <p class="text-sm text-texte-doux">
        Vu au {c.sourceCours} · mesure : {METHODE[c.methode]}
      </p>
      {
        origine && (
          <p class="text-sm text-texte-doux">
            {origine} : une exigence d'une SAÉ précédente, que le sujet ne redemande pas. Elle est mesurée sur le site publié et donnée pour information, sans points. Les lignes citées sont celles de la page reçue par le navigateur, pas celles du dépôt.
          </p>
        )
      }

      {
        c.verdict === "non-mesurable" && (
          <p class="rounded-md border border-bordure bg-surface px-3 py-2 text-sm">
            <span class="font-semibold">Non mesurable :</span> {c.raison}. Ce critère ne compte pas dans la note.
          </p>
        )
      }

      {
        c.pointsProposes && (
          <div class="rounded-md border border-accent/40 bg-accent-fond px-3 py-2 text-sm">
            <p class="font-semibold">
              Points proposés : {nombre(c.pointsProposes.valeur)} / {nombre(c.pointsProposes.max)}
              <span class="font-normal text-texte-doux">
                {" "}· d'après {c.pointsProposes.mesures.filter((m: any) => m.verdict === "respecte").length} mesure(s) respectée(s) sur {c.pointsProposes.mesures.length}
              </span>
            </p>
            <ul class="mt-1 flex flex-wrap gap-1.5" aria-label="Les mesures prises en compte">
              {c.pointsProposes.mesures.map((m: any) => (
                <li>
                  <a href={`#critere-${m.id}`} class="inline-flex items-center gap-1 rounded border border-bordure bg-surface px-1.5 font-mono text-xs underline-offset-2 hover:underline">
                    {m.id} <Verdict verdict={m.verdict} statut="I" />
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-1 text-xs text-texte-doux">
              Respectée 1, partielle ½, non respectée 0 ; une mesure non mesurable est écartée. À valider ou corriger : les points sont ceux du jury.
            </p>
          </div>
        )
      }

      {
        c.proposition && (
          <div class="rounded-md border border-accent/40 bg-accent-fond px-3 py-2 text-sm">
            <p class="font-semibold">
              Proposition de l'IA : {c.proposition.niveau}
              <span class="font-normal text-texte-doux">
                {" "}· sur l'échelle {c.echelle?.join(" < ")}
              </span>
            </p>
            <p class="mt-1 whitespace-pre-line">{c.proposition.justification}</p>
            <p class="mt-1 text-xs text-texte-doux">
              À valider ou corriger : le niveau retenu est celui de l'enseignant. {nombre(c.proposition.preuves.length)} preuve(s) retrouvée(s) mot pour mot
              {c.proposition.preuvesEcartees > 0 && <>, {nombre(c.proposition.preuvesEcartees)} écartée(s) car introuvable(s) à la ligne citée</>} ·{" "}
              <span class="font-mono">{c.proposition.modele}, prompt {c.proposition.prompt}</span>
            </p>
          </div>
        )
      }

      {
        c.statut === "B" && (
          <p class:list={["rounded-md px-3 py-2 text-sm", bonusObtenu ? "bg-bonus-fond text-bonus" : "bg-surface text-texte-doux border border-bordure"]}>
            {bonusObtenu
              ? `Bonus obtenu : ${points(c.points.obtenus)} ajoutés à la note (${nombre(c.valeur)} % des classes en BEM).`
              : `Bonus non obtenu (${nombre(c.valeur)} % des classes en BEM) : il ne retire aucun point.`}
          </p>
        )
      }

      {
        ens ? (
          <div class="rounded-md border border-bordure bg-surface px-3 py-2 text-sm">
            <p class="font-semibold">
              Évaluation de l'enseignant
              {ens.points !== null && c.points && <span class="font-normal"> · {nombre(ens.points)} / {points(c.points.max)}</span>}
              {ens.points !== null && c.pointsProposes && (
                <span class="font-normal text-texte-doux">
                  {ens.points === c.pointsProposes.valeur ? " · la proposition, validée" : ` · l'outil proposait ${nombre(c.pointsProposes.valeur)}`}
                </span>
              )}
            </p>
            {ens.niveau && (
              <p>
                Niveau retenu : <span class="font-semibold">{ens.niveau}</span>
                {c.proposition && <span class="text-texte-doux">{ens.niveau === c.proposition.niveau ? " · la proposition de l'IA, validée" : ` · l'IA proposait « ${c.proposition.niveau} »`}</span>}
              </p>
            )}
            {verdictCorrige && !ens.niveau && <p class="text-texte-doux">Verdict corrigé : l'outil indiquait « {LIBELLE_VERDICT[ens.verdictOutil]} ».</p>}
            {ens.commentaire && <p class="mt-1 whitespace-pre-line">{ens.commentaire}</p>}
          </div>
        ) : (
          c.verdict === "a-juger" && (
            <div class="rounded-md border border-dashed border-bordure bg-surface px-3 py-2 text-sm text-texte-doux">
              <p class="font-semibold text-texte">Note et commentaire de l'enseignant</p>
              <p>Pas encore évalué.{c.points && ` Ce critère vaut ${points(c.points.max)}.`}</p>
            </div>
          )
        )
      }

      {modeLocal && c.statut !== "B" && <NoteEnseignant client:visible slug={slug} critere={c} />}

      {c.id === "A6" && images && images.length > 0 && <ListeAlt images={images} />}

      {
        c.occurrences.length > 0 && (
          <Occurrences
            occurrences={c.occurrences}
            total={c.totalOccurrences}
            titre={c.verdict === "a-juger" ? "Éléments relevés pour juger" : "Occurrences"}
            ton={c.verdict === "a-juger" ? "neutre" : "fautif"}
          />
        )
      }
    </div>
  </details>
</li>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
