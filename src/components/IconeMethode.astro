---
/** Méthode de mesure d'un critère : une icône, et son nom pour les lecteurs d'écran */
interface Props {
  methode: "auto" | "depot" | "navigateur" | "ia" | "manuel";
}

const { methode } = Astro.props;

const LIBELLES = {
  auto: "Analyse du code",
  depot: "Lecture du dépôt",
  navigateur: "Navigateur automatisé",
  ia: "Proposé par l'IA, à valider",
  manuel: "Jugement manuel",
};
---

<span class="inline-flex text-texte-doux" title={LIBELLES[methode]}>
  <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {methode === "auto" && <path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4" />}
    {methode === "depot" && <path d="M2 4.5h4l1.5 1.5H14v6.5H2z" />}
    {methode === "navigateur" && <><rect x="2" y="3" width="12" height="10" rx="1" /><path d="M2 6h12" /></>}
    {methode === "ia" && <path d="M8 2.5 9.3 6.7 13.5 8 9.3 9.3 8 13.5 6.7 9.3 2.5 8 6.7 6.7z" />}
    {methode === "manuel" && <path d="m3 13 1-3.5L10.5 3 13 5.5 6.5 12zM9 4.5 11.5 7" />}
  </svg>
  <span class="sr-only">{LIBELLES[methode]}</span>
</span>
