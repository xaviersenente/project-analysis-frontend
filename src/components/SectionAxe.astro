---
/**
 * Un axe : en-tête, filtres et liste des critères (des lignes, pas des cartes).
 */
import JaugeAxe from "./JaugeAxe.astro";
import LigneCritere from "./LigneCritere.astro";
import { COULEUR_AXE } from "../config/axes.js";

interface Props {
  axe: { id: string; nom: string; description: string };
  criteres: any[];
  pointsAxe: { obtenus: number; max: number };
  moyenne: number | null;
  images?: any[];
}

const { axe, criteres, pointsAxe, moyenne, images } = Astro.props;
const id = (suffixe: string) => `${axe.id}-${suffixe}`;
---

<section
  id={`axe-${axe.id}`}
  aria-labelledby={id("titre")}
  class={`rounded-lg border border-bordure border-l-4 bg-surface ${COULEUR_AXE[axe.id].lisere}`}
  data-section-axe>
  <header class="grid gap-3 border-b border-bordure p-4 md:grid-cols-[minmax(0,1fr)_18rem] md:items-center">
    <div>
      <h2 id={id("titre")} class="text-xl font-bold">{axe.nom}</h2>
      <p class="text-sm text-texte-doux">{axe.description}</p>
    </div>
    <JaugeAxe axe={axe} obtenus={pointsAxe.obtenus} max={pointsAxe.max} moyenne={moyenne} lien={false} />
  </header>

  <!-- Blocs propres à l'axe (palette, scores, JavaScript…) -->
  <slot />

  <!-- Filtres : affichés seulement quand le script les rend opérants -->
  <form class="filtres flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-bordure px-4 py-3" hidden aria-label={`Filtrer les critères ${axe.nom}`}>
    <fieldset class="flex rounded-md border border-bordure p-0.5">
      <legend class="sr-only">Afficher</legend>
      {
        [
          ["tous", "Tous"],
          ["non-respectes", "Non respectés"],
          ["a-juger", "À juger"],
        ].map(([valeur, libelle], index) => (
          <label class="segment cursor-pointer rounded px-3 py-1 text-sm">
            <input type="radio" name="vue" value={valeur} checked={index === 0} class="sr-only" />
            {libelle}
          </label>
        ))
      }
    </fieldset>

    <label class="flex cursor-pointer items-center gap-2 text-sm">
      <input type="checkbox" name="masquerRecommandations" role="switch" class="interrupteur" />
      Masquer les recommandations
    </label>

    <label class="ml-auto flex items-center gap-2 text-sm">
      <span class="sr-only">Rechercher un critère {axe.nom}</span>
      <input
        type="search"
        name="recherche"
        placeholder="Rechercher un critère"
        autocomplete="off"
        class="h-9 w-56 rounded-md border border-bordure bg-surface px-3"
      />
    </label>

    <p class="compte w-full text-xs text-texte-doux md:w-auto" aria-live="polite"></p>
  </form>

  <ul class="divide-y divide-bordure">
    {criteres.map((c) => <LigneCritere critere={c} images={images} />)}
  </ul>
  <p class="aucun px-4 py-3 text-sm text-texte-doux" hidden>Aucun critère ne correspond à ces filtres.</p>
</section>

<style>
  .segment:has(input:checked) {
    background: var(--color-accent);
    color: white;
    font-weight: 600;
  }
  .segment:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Interrupteur : une case à cocher native, dessinée */
  .interrupteur {
    appearance: none;
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--color-texte-doux);
    cursor: pointer;
  }
  .interrupteur::after {
    content: "";
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: white;
    transition: transform 0.15s;
  }
  .interrupteur:checked {
    background: var(--color-accent);
  }
  .interrupteur:checked::after {
    transform: translateX(1rem);
  }
</style>

<script>
  import { correspondAuFiltre } from "../lib/criteres.js";

  for (const section of document.querySelectorAll<HTMLElement>("[data-section-axe]")) {
    const formulaire = section.querySelector<HTMLFormElement>(".filtres")!;
    const lignes = [...section.querySelectorAll<HTMLElement>("[data-critere]")];
    const compte = section.querySelector<HTMLElement>(".compte")!;
    const aucun = section.querySelector<HTMLElement>(".aucun")!;

    const appliquer = () => {
      const donnees = new FormData(formulaire);
      const filtres = {
        vue: String(donnees.get("vue")) as "tous" | "non-respectes" | "a-juger",
        masquerRecommandations: donnees.has("masquerRecommandations"),
        recherche: String(donnees.get("recherche") ?? ""),
      };
      let visibles = 0;
      for (const ligne of lignes) {
        const visible = correspondAuFiltre(
          { verdict: ligne.dataset.verdict!, statut: ligne.dataset.statut!, texte: ligne.dataset.texte! },
          filtres
        );
        ligne.hidden = !visible;
        if (visible) visibles++;
      }
      compte.textContent = `${visibles} critère${visibles > 1 ? "s" : ""} sur ${lignes.length}`;
      aucun.hidden = visibles > 0;
    };

    formulaire.addEventListener("input", appliquer);
    formulaire.addEventListener("submit", (evenement) => evenement.preventDefault());
    formulaire.hidden = false;
    appliquer();
  }

  // Un lien vers un critère (priorités, recommandations) l'ouvre et le rend visible
  const ouvrirCritereCible = () => {
    const cible = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    if (!cible?.matches("[data-critere]")) return;
    const section = cible.closest<HTMLElement>("[data-section-axe]");
    const formulaire = section?.querySelector<HTMLFormElement>(".filtres");
    if (cible.hidden && formulaire) {
      formulaire.reset();
      formulaire.dispatchEvent(new Event("input"));
    }
    cible.querySelector("details")?.setAttribute("open", "");
    cible.scrollIntoView({ block: "start" });
  };
  window.addEventListener("hashchange", ouvrirCritereCible);
  ouvrirCritereCible();
</script>
