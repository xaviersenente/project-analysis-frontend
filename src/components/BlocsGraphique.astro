---
/**
 * Graphique : palette par rôle, échelle d'espacement, échelle typographique, polices chargées,
 * et la comparaison avec la maquette Figma (G11)
 */
import { grouperPalette, estClaire, largeurRelative, famillesPolices, cssPolices, nomPolice } from "../lib/blocs.js";
import { nombre } from "../lib/format.js";
import BlocMaquette from "./BlocMaquette.astro";

interface Props {
  bloc: any | undefined;
  polices: any[] | undefined;
}

const { bloc, polices } = Astro.props;
const ROLE: Record<string, string> = {
  surface: "Surface",
  texte: "Texte",
  accent: "Accent",
  bordure: "Bordure",
  autre: "Sans rôle (nommée par sa teinte)",
};
const groupes = bloc?.palette ? grouperPalette(bloc.palette) : [];
const maxEspace = bloc?.espacements ? Math.max(...bloc.espacements.map((e: any) => e.px), 1) : 1;
const famille = bloc?.typographie?.famille;
// Polices de l'étudiant, chargées depuis leur copie publiée avec le projet
const familles = polices ? famillesPolices(polices) : [];
const css = polices ? cssPolices(polices) : "";
const familleCopiee = famille && polices?.some((p: any) => p.famille === famille && p.copie);
const policeEchelle = familleCopiee ? `"${nomPolice(famille)}", var(--font-sans)` : `"${famille ?? ""}", var(--font-sans)`;
---

<div class="grid gap-4 border-b border-bordure p-4 lg:grid-cols-2">
  <!-- Palette -->
  <div class="rounded-md border border-bordure p-3">
    <h3 class="mb-2 text-sm font-semibold">Palette déclarée dans <code class="font-mono">:root</code></h3>
    {
      !bloc?.palette ? (
        <p class="text-sm text-texte-doux">Non mesurable.</p>
      ) : (
        <div class="space-y-2">
          {groupes.map((g) => (
            <div>
              <p class:list={["text-xs font-semibold", g.role === "autre" ? "text-partiel" : "text-texte-doux"]}>
                {g.role === "autre" && <span aria-hidden="true">◐ </span>}
                {ROLE[g.role]}
              </p>
              <ul class="mt-1 flex flex-wrap gap-2">
                {g.couleurs.map((c: any) => (
                  <li class="flex items-center gap-2 rounded border border-bordure py-1 pr-2 pl-1">
                    {c.couleur ? (
                      <span
                        class:list={["size-6 rounded", estClaire(c.couleur) && "ring-1 ring-texte-doux/40"]}
                        style={`background: ${c.couleur}`}
                        aria-hidden="true"
                      />
                    ) : (
                      <span class="grid size-6 place-items-center rounded border border-dashed border-texte-doux/60 text-xs text-texte-doux" title="Variable introuvable dans la palette">?</span>
                    )}
                    <span class="font-mono text-xs">
                      <span class="block">{c.variable}</span>
                      <span class="block text-texte-doux">
                        {c.valeur}
                        {c.couleur && c.couleur !== c.valeur && <> → {c.couleur}</>}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </div>

  <!-- Échelle d'espacement -->
  <div class="rounded-md border border-bordure p-3">
    <h3 class="mb-2 text-sm font-semibold">Échelle d'espacement</h3>
    {
      !bloc?.espacements ? (
        <p class="text-sm text-texte-doux">Non mesurable.</p>
      ) : (
        <ul class="space-y-1.5">
          {bloc.espacements.map((e: any) => (
            <li class="grid grid-cols-[8rem_4rem_minmax(0,1fr)] items-center gap-2 text-xs">
              <span class="font-mono">{e.variable ?? "—"}</span>
              <span class="text-right text-texte-doux">{nombre(e.px)} px</span>
              <span class="h-3 rounded-sm bg-texte-doux/60" style={{ width: largeurRelative(e.px, maxEspace) }} aria-hidden="true" />
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <!-- Polices du site : chaque famille dans sa vraie police, une ligne par graisse -->
  {css && <style is:inline set:html={css} />}
  {
    familles.length > 0 && (
      <div class="rounded-md border border-bordure p-3 lg:col-span-2">
        <h3 class="mb-2 text-sm font-semibold">
          Polices du site
          <span class="font-normal text-texte-doux">
            · {familles.length} famille{familles.length > 1 ? "s" : ""}, {nombre(polices!.length)} fichier{polices!.length > 1 ? "s" : ""},{" "}
            {nombre(polices!.reduce((s: number, p: any) => s + p.poidsKo, 0))} Ko ·{" "}
            <a href="#ressources" class="text-accent underline underline-offset-2">détail dans Ressources</a>
          </span>
        </h3>
        <div class="space-y-3">
          {familles.map((f) => (
            <div>
              <p class="text-xs font-semibold text-texte-doux">{f.famille}</p>
              <ul class="mt-1 space-y-1">
                {f.graisses.map((g: any) => (
                  <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-2">
                    <span class="font-mono text-xs text-texte-doux">{g.graisse}</span>
                    {g.copie ? (
                      <span class="truncate text-2xl leading-tight" style={`font-family: "${f.nom}", var(--font-sans); font-weight: ${g.valeur}`}>
                        Portez ce vieux whisky au juge blond · 0123 « éàç »
                      </span>
                    ) : (
                      <span class="text-sm text-texte-doux">fichier absent de la version évaluée : pas d'aperçu</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- Échelle typographique -->
  <div class="rounded-md border border-bordure p-3 lg:col-span-2">
    <h3 class="mb-2 text-sm font-semibold">
      Échelle typographique
      {
        bloc?.typographie && (
          <span class="font-normal text-texte-doux">
            · {bloc.typographie.tailles.length} tailles{famille && (familleCopiee ? <>, en {famille}</> : <>, en {famille} si la police est installée sur ce poste</>)}
          </span>
        )
      }
    </h3>
    {
      !bloc?.typographie ? (
        <p class="text-sm text-texte-doux">Non mesurable.</p>
      ) : (
        <ul class="space-y-1">
          {bloc.typographie.tailles.map((t: any) => (
            <li class="grid grid-cols-[8rem_6rem_minmax(0,1fr)] items-baseline gap-2">
              <span class="font-mono text-xs">{t.variable ?? "en dur"}</span>
              <span class="text-xs text-texte-doux">
                {t.valeur.endsWith("px") ? `${nombre(t.px)} px` : `${t.valeur} · ${nombre(t.px)} px`}
              </span>
              <span class="truncate leading-tight" style={`font-size: ${t.px}px; font-family: ${policeEchelle}`} aria-hidden="true">
                Le studio BBrands
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {bloc?.maquette && <BlocMaquette maquette={bloc.maquette} />}
</div>
