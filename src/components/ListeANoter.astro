---
/**
 * Mode local : la liste de travail de l'enseignant, en tête de page. Les critères que l'outil laisse
 * à juger (points, niveau proposé par l'IA, verdict), chacun avec ce qui aide à décider et son
 * formulaire ; les critères déjà notés sont repliés en fin de liste. Le site construit ne l'a pas.
 */
import type { Critere, Image } from "../types";
import LigneCritere from "./LigneCritere.astro";
import { couleurAxe } from "../config/axes.js";
import { criteresANoter } from "../lib/synthese.js";

interface Props {
  criteres: Critere[];
  axes: { id: string; nom: string }[];
  images?: Image[];
  slug: string;
}

const { criteres, axes, images, slug } = Astro.props;
const { restants, notes } = criteresANoter(criteres);
const total = restants.length + notes.length;
const axeDe = (c: Critere) => axes.find((a) => a.id === c.axe)!;
const pastille = (c: Critere) => couleurAxe(c.axe, axes.findIndex((a) => a.id === c.axe)).pastille;
---

{
  total > 0 && (
    <section id="a-noter" aria-labelledby="titre-a-noter" class="rounded-lg border-2 border-accent/50 bg-surface">
      <header class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-bordure px-4 py-3">
        <h2 id="titre-a-noter" class="text-xl font-bold">À noter</h2>
        <p class="text-sm text-texte-doux">
          <span class="font-semibold text-texte">{notes.length} / {total}</span> notés · chaque critère avec ce qui aide à décider et son formulaire
        </p>
        <progress class="h-2 w-40 accent-[var(--color-accent)]" max={total} value={notes.length} aria-label="Critères notés">
          {notes.length} sur {total}
        </progress>
      </header>

      {
        restants.length === 0 ? (
          <p class="px-4 py-3 text-sm">Tout est noté. Pensez au commentaire général, dans la synthèse.</p>
        ) : (
          <ul class="divide-y divide-bordure">
            {restants.map((c, i) => (
              <>
                {(i === 0 || restants[i - 1].axe !== c.axe) && (
                  <li class="flex items-center gap-2 bg-page px-4 py-1.5 text-xs font-semibold tracking-wide text-texte-doux uppercase">
                    <span class={`size-2 rounded-full ${pastille(c)}`} aria-hidden="true" />
                    {axeDe(c).nom}
                  </li>
                )}
                <LigneCritere critere={c} images={images} slug={slug} dansListe={{ axe: axeDe(c) }} />
              </>
            ))}
          </ul>
        )
      }

      {
        notes.length > 0 && (
          <details class="groupe-criteres border-t border-bordure">
            <summary class="cursor-pointer px-4 py-2.5 text-sm font-semibold text-texte-doux hover:bg-neutre-fond">Déjà notés ({notes.length})</summary>
            <ul class="divide-y divide-bordure border-t border-bordure">
              {notes.map((c) => (
                <LigneCritere critere={c} images={images} slug={slug} dansListe={{ axe: axeDe(c) }} />
              ))}
            </ul>
          </details>
        )
      }
    </section>
  )
}
