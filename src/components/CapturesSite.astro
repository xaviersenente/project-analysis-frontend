---
/**
 * Portfolio : les captures du site en ligne, pour juger la direction artistique.
 * L'accueil aux trois largeurs, puis chaque page à 360 px. Une capture s'ouvre en grand.
 */
interface Props {
  parcours: any | undefined;
}

const { parcours } = Astro.props;
const pages = (parcours?.pages ?? []).filter((p: any) => p.captures.length > 0);
const [accueil, ...autres] = pages;
---

<div class="border-b border-bordure p-4">
  <h3 class="mb-2 text-sm font-semibold">
    Captures du site en ligne
    {parcours && <span class="font-normal text-texte-doux"> · prises dans une navigation privée, sans rien accepter</span>}
  </h3>
  {
    !accueil ? (
      <p class="text-sm text-texte-doux">Non mesurable : le site n'a pas été parcouru.</p>
    ) : (
      <div class="space-y-4">
        <figure>
          <figcaption class="mb-1 text-xs font-semibold text-texte-doux">
            Accueil <span class="font-mono font-normal">{accueil.chemin}</span>
          </figcaption>
          <ul class="flex items-start gap-3 overflow-x-auto pb-2" tabindex="0" role="region" aria-label="Accueil à trois largeurs, défilable">
            {accueil.captures.map((c: any) => (
              <li class="shrink-0">
                <a href={c.image} class="block rounded border border-bordure" target="_blank" rel="noopener">
                  <img src={c.image} alt={`Accueil à ${c.largeur} px`} loading="lazy" class="max-h-96 w-auto" style={`width: ${Math.round(c.largeur / 4)}px`} />
                </a>
                <span class="mt-1 block text-center text-xs text-texte-doux">{c.largeur} px</span>
              </li>
            ))}
          </ul>
        </figure>
        {autres.length > 0 && (
          <figure>
            <figcaption class="mb-1 text-xs font-semibold text-texte-doux">Les autres pages à 360 px</figcaption>
            <ul class="flex items-start gap-3 overflow-x-auto pb-2" tabindex="0" role="region" aria-label="Pages à 360 px, défilable">
              {autres.map((p: any) => (
                <li class="w-24 shrink-0">
                  <a href={p.captures[0].image} class="block rounded border border-bordure" target="_blank" rel="noopener">
                    <img src={p.captures[0].image} alt={`${p.titre ?? p.chemin} à 360 px`} loading="lazy" class="max-h-56 w-full object-cover object-top" />
                  </a>
                  <span class="mt-1 block truncate font-mono text-xs text-texte-doux" title={p.chemin}>{p.chemin}</span>
                </li>
              ))}
            </ul>
          </figure>
        )}
      </div>
    )
  }
</div>
