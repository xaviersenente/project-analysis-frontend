---
/**
 * Un verdict : toujours une icône et un mot, jamais la couleur seule.
 * Un code couleur par verdict : vert respecté, rouge non respecté, ambre partiel, bleu à juger,
 * gris non mesurable. Une contrainte est pleine ; une recommandation ou une information
 * garde la même couleur en contour, plus discrète. Un bonus non obtenu reste neutre.
 */
import { VERDICTS, motVerdict } from "../config/verdicts.js";

interface Props {
  verdict: string;
  statut: string;
}

const { verdict, statut } = Astro.props;

const recommande = statut === "R" || statut === "I";
const bonus = statut === "B";
// Contrainte : fond coloré ; recommandation, information : contour de la même couleur.
// Classes écrites en entier, pour que Tailwind les trouve
const TEINTES: Record<string, [string, string]> = {
  respecte: ["text-respecte bg-respecte-fond border border-transparent", "text-respecte bg-surface border border-respecte/50"],
  "non-respecte": ["text-non-respecte bg-non-respecte-fond border border-transparent", "text-non-respecte bg-surface border border-non-respecte/50"],
  partiel: ["text-partiel bg-partiel-fond border border-transparent", "text-partiel bg-surface border border-partiel/50"],
};
const teinte = (verdict: string) => TEINTES[verdict][recommande ? 1 : 0];

// Mot et icône communs (config/verdicts.js) ; un bonus se dit « obtenu » ou « non obtenu »
const base = (v: string) => ({ mot: motVerdict(v, { majuscule: true }), icone: VERDICTS[v as keyof typeof VERDICTS].icone });
const STYLES: Record<string, { mot: string; icone: string; classe: string }> = {
  respecte: bonus ? { mot: "Obtenu", icone: "✓", classe: "text-bonus bg-bonus-fond border border-transparent" } : { ...base("respecte"), classe: teinte("respecte") },
  "non-respecte": bonus
    ? { mot: "Non obtenu", icone: "○", classe: "text-neutre bg-neutre-fond border border-transparent" }
    : { ...base("non-respecte"), classe: teinte("non-respecte") },
  partiel: { ...base("partiel"), classe: teinte("partiel") },
  "non-mesurable": { ...base("non-mesurable"), classe: "text-neutre bg-neutre-fond border border-transparent" },
  "a-juger": { ...base("a-juger"), classe: "text-accent bg-accent-fond border border-accent/40" },
};

const style = STYLES[verdict];
---

<span class={`inline-flex items-center gap-1.5 rounded px-1.5 py-0.5 text-xs font-semibold whitespace-nowrap ${style.classe}`}>
  <span aria-hidden="true">{style.icone}</span>
  {style.mot}
</span>
