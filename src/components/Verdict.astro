---
/**
 * Un verdict : toujours une icône et un mot, jamais la couleur seule.
 * Une recommandation non suivie reste calme (jamais rouge) ; un bonus non obtenu reste neutre.
 */
interface Props {
  verdict: string;
  statut: string;
}

const { verdict, statut } = Astro.props;

const recommande = statut === "R" || statut === "I";
const bonus = statut === "B";

const STYLES: Record<string, { mot: string; icone: string; classe: string }> = {
  respecte: { mot: bonus ? "Obtenu" : "Respecté", icone: "✓", classe: bonus ? "text-bonus bg-bonus-fond" : "text-respecte bg-respecte-fond" },
  "non-respecte": bonus
    ? { mot: "Non obtenu", icone: "○", classe: "text-neutre bg-neutre-fond" }
    : recommande
      ? { mot: "À suivre", icone: "→", classe: "text-neutre bg-neutre-fond" }
      : { mot: "Non respecté", icone: "✕", classe: "text-non-respecte bg-non-respecte-fond" },
  partiel: { mot: "Partiel", icone: "◐", classe: recommande ? "text-neutre bg-neutre-fond" : "text-partiel bg-partiel-fond" },
  "non-mesurable": { mot: "Non mesurable", icone: "?", classe: "text-neutre bg-neutre-fond" },
  "a-juger": { mot: "À juger", icone: "✎", classe: "text-neutre bg-neutre-fond" },
};

const style = STYLES[verdict];
---

<span class={`inline-flex items-center gap-1.5 rounded px-1.5 py-0.5 text-xs font-semibold whitespace-nowrap ${style.classe}`}>
  <span aria-hidden="true">{style.icone}</span>
  {style.mot}
</span>
