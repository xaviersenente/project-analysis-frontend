---
import Base from "../../layouts/Base.astro";
import BarreSuperieure from "../../components/BarreSuperieure.astro";
import NavLaterale from "../../components/NavLaterale.astro";
import Synthese from "../../components/Synthese.astro";
import SectionAxe from "../../components/SectionAxe.astro";
import VueParPage from "../../components/VueParPage.astro";
import Ressources from "../../components/Ressources.astro";
import Timeline from "../../components/Timeline.astro";
import BlocsGraphique from "../../components/BlocsGraphique.astro";
import BlocsAccessibilite from "../../components/BlocsAccessibilite.astro";
import BlocsMethodologie from "../../components/BlocsMethodologie.astro";
import Verdict from "../../components/Verdict.astro";
import SiteParcouru from "../../components/SiteParcouru.astro";
import CapturesSite from "../../components/CapturesSite.astro";
import { sectionsAnalyse } from "../../config/sections.js";
import { badgesParAxe } from "../../lib/synthese.js";
import { donneesSite } from "../../lib/site.js";

export function getStaticPaths() {
  const { promo } = donneesSite();
  return promo.projets.map((projet, index) => ({
    params: { slug: projet.slug },
    props: {
      projet,
      precedent: promo.projets[index - 1]?.slug ?? null,
      suivant: promo.projets[index + 1]?.slug ?? null,
    },
  }));
}

const { projet, precedent, suivant } = Astro.props;
const { resultats, options, moyennes } = donneesSite();
const resultat = resultats.get(projet.slug) ?? null;
// Seuils lus dans les critères du résultat
const seuilDe = (id: string) => resultat?.criteres.find((c: any) => c.id === id)?.seuil?.nombre ?? null;

const sections = resultat ? sectionsAnalyse(resultat.grille.profil) : [];
const avecSection = (id: string) => sections.some((s) => s.id === id);

const recommandations = resultat
  ? resultat.criteres.filter((c: any) => ["R", "I"].includes(c.statut) && ["non-respecte", "partiel"].includes(c.verdict))
  : [];
---

<Base titre={`${projet.nom} · ${projet.groupe}`}>
  <BarreSuperieure
    sae={resultat?.grille.nom}
    options={options}
    courantSlug={projet.slug}
    precedent={precedent}
    suivant={suivant}
    analyseLe={resultat?.source.analyseLe ?? null}
    liens={resultat?.liens ?? null}
  />

  <div class="lg:flex">
    <NavLaterale
      badges={resultat ? badgesParAxe(resultat.criteres, resultat.grille.axes) : null}
      axes={resultat?.grille.axes}
      sections={sections}
      recommandations={recommandations.length}
    />

    <main id="contenu" class="mx-auto w-full max-w-[100rem] min-w-0 space-y-8 p-4 lg:p-8">
      <h1 class="sr-only">Analyse du projet de {projet.nom}</h1>

      {
        resultat ? (
          <>
            <Synthese resultat={resultat} moyennes={moyennes} />

            {resultat.grille.axes.map((axe: any, rang: number) => (
              <SectionAxe
                axe={axe}
                rang={rang}
                criteres={resultat.criteres.filter((c: any) => c.axe === axe.id)}
                pointsAxe={resultat.note.parAxe[axe.id]}
                moyenne={moyennes?.parAxe[axe.id] ?? null}
                images={resultat.ressources?.images}
                slug={resultat.projet.slug}>
                {axe.id === "graphique" && <BlocsGraphique bloc={resultat.blocs?.graphique} polices={resultat.ressources?.polices} />}
                {axe.id === "accessibilite" && <BlocsAccessibilite bloc={resultat.blocs?.accessibilite} objectifLighthouse={seuilDe("A13")} />}
                {axe.id === "methodologie" && <BlocsMethodologie bloc={resultat.blocs?.methodologie} seuilBem={seuilDe("M7")} />}
                {axe.id === "direction-artistique" && <CapturesSite parcours={resultat.parcours} />}
              </SectionAxe>
            ))}

            {avecSection("par-page") && <VueParPage pages={resultat.pages} langues={resultat.langues} />}
            {avecSection("site") && <SiteParcouru parcours={resultat.parcours} />}
            {avecSection("timeline") && <Timeline historique={resultat.historique} />}
            {avecSection("ressources") && <Ressources ressources={resultat.ressources} criteres={resultat.criteres} enLigne={resultat.enLigne} sha={resultat.source.sha} />}

            <section id="recommandations" aria-labelledby="titre-recommandations" class="rounded-lg border border-bordure bg-surface">
              <h2 id="titre-recommandations" class="border-b border-bordure px-4 py-3 text-xl font-bold">
                Recommandations
                <span class="ml-2 text-sm font-normal text-texte-doux">sans point : des pistes pour aller plus loin, et les mesures données pour information</span>
              </h2>
              {recommandations.length === 0 ? (
                <p class="px-4 py-3 text-sm text-texte-doux">Toutes les recommandations sont suivies.</p>
              ) : (
                <ul class="divide-y divide-bordure">
                  {recommandations.map((c: any) => (
                    <li class="grid grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline gap-3 px-4 py-2.5">
                      <a href={`#critere-${c.id}`} class="font-mono text-sm font-semibold text-accent underline underline-offset-2">{c.id}</a>
                      <span>
                        <span class="block">{c.libelle}</span>
                        <span class="block text-sm text-texte-doux">{c.piste}</span>
                      </span>
                      <Verdict verdict={c.verdict} statut={c.statut} />
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </>
        ) : (
          <section id="synthese" class="rounded-lg border border-bordure bg-surface p-8">
            <h2 class="text-2xl font-bold">{projet.nom} <span class="text-base font-semibold text-texte-doux">{projet.groupe}</span></h2>
            <p class="mt-2">Ce projet n'a pas encore été analysé.</p>
            <p class="mt-1 text-sm text-texte-doux">Lancez l'analyse en local, puis reconstruisez le site.</p>
          </section>
        )
      }
    </main>
  </div>
  {
    import.meta.env.DEV && (
      <script is:inline>
        // Mode local : après un enregistrement, la page revient sur le critère noté
        try {
          const id = sessionStorage.getItem("webscope-retour");
          sessionStorage.removeItem("webscope-retour");
          const ligne = id && document.getElementById(`critere-${id}`);
          if (ligne) {
            ligne.querySelector("details").open = true;
            ligne.scrollIntoView({ block: "center" });
          }
        } catch {}
      </script>
    )
  }
</Base>
